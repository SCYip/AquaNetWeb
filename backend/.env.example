# Server Configuration
PORT=3000
NODE_ENV=development

# Database - Supabase PostgreSQL
# Get these from: Supabase Dashboard > Settings > Database
#
# Option A: Transaction Pooler (recommended for serverless / connection pooling)
#   Connection string format:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#   Pool mode: Transaction — use this for serverless functions, Express on shared hosting
#
# Option B: Direct Connection (for local dev or long-lived connections)
#   Connection string format:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Find your project ref in: Supabase Dashboard > Settings > General

# --- Supabase Connection Pooler (recommended) ---
# DB_HOST=aws-0-xxxxxx.pooler.supabase.com
# DB_PORT=6543
# DB_USER=postgres.[PROJECT-REF]
# DB_PASSWORD=your_supabase_db_password
# DB_NAME=postgres
# DB_SSL=true

# --- Supabase Direct Connection (local dev) ---
# DB_HOST=aws-0-xxxxxx.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.[PROJECT-REF]
# DB_PASSWORD=your_supabase_db_password
# DB_NAME=postgres
# DB_SSL=true

# --- Supabase Client (for Admin operations via @supabase/supabase-js) ---
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# WeChat OAuth (optional - for Chinese users)
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_secret

# Alibaba Cloud SMS (optional - for phone verification in China)
ALIYUN_ACCESS_KEY_ID=your_access_key
ALIYUN_ACCESS_KEY_SECRET=your_secret
ALIYUN_SMS_SIGN_NAME=AquaNet
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxx

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://aquanet-water.org,https://www.aquanet-water.org
